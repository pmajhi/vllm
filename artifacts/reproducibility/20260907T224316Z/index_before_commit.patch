+"""Experimental request-level configuration for heterogeneous KV codecs."""
+
+import os
+
+from vllm.v1.worker.experimental.hetero_kv_codec_registry import (
+    HeteroKVCodecId,
+)
+
+HETERO_KV_DEFAULT_QUANTIZER_ID_ENV_VAR = (
+    "VLLM_EXPERIMENTAL_DEFAULT_KV_QUANTIZER_ID"
+)
+
+
+def get_hetero_kv_default_quantizer_id() -> int:
+    """Return the default experimental KV codec ID for new V1 requests.
+
+    The default remains baseline ID 0. This is an internal diagnostic switch
+    for exercising experimental cache paths before a public per-request codec
+    API is introduced.
+    """
+    configured_value = os.getenv(HETERO_KV_DEFAULT_QUANTIZER_ID_ENV_VAR)
+    if configured_value is None:
+        return int(HeteroKVCodecId.BASELINE)
+
+    try:
+        codec_id = int(configured_value)
+    except ValueError as exc:
+        raise ValueError(
+            f"{HETERO_KV_DEFAULT_QUANTIZER_ID_ENV_VAR} must be an integer, "
+            f"got {configured_value!r}"
+        ) from exc
+
+    try:
+        return int(HeteroKVCodecId(codec_id))
+    except ValueError as exc:
+        raise ValueError(
+            f"{HETERO_KV_DEFAULT_QUANTIZER_ID_ENV_VAR} has unsupported "
+            f"codec ID {codec_id}"
+        ) from exc
